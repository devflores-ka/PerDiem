<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>PerDiem</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>PerDiem</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>perdiem.deeplink</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>perdiem</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>https</string>
		<string>http</string>
	</array>
	<key>LSRequiresIPhoneOS</key>
	<true/>
    <key>NSCameraUsageDescription</key>
    <string>PerDiem usa la cámara para que fotografíes boletas, facturas y comprobantes de gastos, adjuntándolos automáticamente al registro correspondiente.</string>
    <key>NSPhotoLibraryUsageDescription</key>
    <string>PerDiem accede a tu galería para que puedas adjuntar fotos ya existentes de boletas, comprobantes o documentos legales a tus registros de gastos.</string>
	<!-- ✅ ELIMINADO: NSLocationAlwaysAndWhenInUseUsageDescription — NO declarar si no se usa
	     Apple rechaza apps que piden Always sin justificación aprobada (equivalente a
	     ACCESS_BACKGROUND_LOCATION en Android, removido por el mismo motivo) -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>PerDiem usa tu ubicación mientras usas la app para asociar automáticamente cada gasto o servicio al lugar donde ocurrió, evitando que tengas que ingresarlo manualmente.</string>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<!-- ✅ ELIMINADO: "location" de UIBackgroundModes — no se hace tracking en segundo plano
	     (equivalente a remover FOREGROUND_SERVICE_LOCATION en Android).
	     Se mantiene "fetch" si la app usa background fetch para otra función (ej. sync). -->
	<key>UIBackgroundModes</key>
    <array>
        <string>fetch</string>
    </array>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>io.flutter.embedded_views_preview</key>
	<true/>
</dict>
</plist>
